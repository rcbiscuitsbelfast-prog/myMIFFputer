# Basic Server Configuration
PORT=4000
HTTP_PORT=4100
DOMAIN=puter.localhost
PROTOCOL=http
CONTACT_EMAIL=hey@example.com

# MIFF Configuration
MIFF_CONTENT_DIR=

# MIFF LLM Proxy Configuration
MIFF_LLM_PROVIDER=together
MIFF_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
MIFF_LLM_API_KEY=your_api_key_here
MIFF_LLM_TIMEOUT=30000
MIFF_LLM_RATE_LIMIT_WINDOW=60000
MIFF_LLM_RATE_LIMIT_MAX=10

# Database Configuration
DATABASE_ENGINE=sqlite
DATABASE_PATH=puter-database.sqlite

# AI/LLM Service Configuration (Optional)
# Uncomment and add your API keys for the services you want to use

# OpenAI (GPT, DALL-E, TTS, etc.)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# Together AI
# TOGETHER_AI_API_KEY=your_together_ai_key_here

# Mistral
# MISTRAL_API_KEY=your_mistral_api_key_here

# Groq
# GROQ_API_KEY=your_groq_api_key_here

# xAI
# XAI_API_KEY=your_xai_api_key_here

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS Services (Polly, Textract)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# Optional: Redis for caching
# REDIS_URL=redis://localhost:6379

# Ollama (Local AI)
# OLLAMA_ENABLED=true

# Development Settings
DEVCONSOLE=1
